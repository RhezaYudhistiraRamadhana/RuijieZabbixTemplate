            <valuemaps>
                <valuemap>
                    <uuid>38e523a642044fc28e02c45e8c87f518</uuid>
                    <name>Service state</name>
                    <mappings>
                        <mapping><value>0</value><newvalue>Down</newvalue></mapping>
                        <mapping><value>1</value><newvalue>Up</newvalue></mapping>
                    </mappings>
                </valuemap>
                <valuemap>
                    <uuid>aeda74d8edec49d68a60ff262a533667</uuid>
                    <name>IF-MIB ifOperStatus</name>
                    <mappings>
                        <mapping><value>1</value><newvalue>up</newvalue></mapping>
                        <mapping><value>2</value><newvalue>down</newvalue></mapping>
                        <mapping><value>3</value><newvalue>testing</newvalue></mapping>
                        <mapping><value>4</value><newvalue>unknown</newvalue></mapping>
                        <mapping><value>5</value><newvalue>dormant</newvalue></mapping>
                        <mapping><value>6</value><newvalue>notPresent</newvalue></mapping>
                        <mapping><value>7</value><newvalue>lowerLayerDown</newvalue></mapping>
                    </mappings>
                </valuemap>
                <valuemap>
                    <uuid>7fc7183fda3944ad936500804135ef7d</uuid>
                    <name>zabbix.host.available</name>
                    <mappings>
                        <mapping><value>0</value><newvalue>available</newvalue></mapping>
                        <mapping><value>1</value><newvalue>unavailable</newvalue></mapping>
                        <mapping><value>2</value><newvalue>unknown</newvalue></mapping>
                    </mappings>
                </valuemap>
            </valuemaps>
        </template>
    </templates>
    <triggers>
        <trigger>
            <uuid>27795d22a609498e9c098deff15c6bfc</uuid>
            <expression>max(/Template SNMP Ruijie AP820-L V3/icmpping,#3)=0</expression>
            <name>AP is UNREACHABLE - ICMP failed 3 times in a row</name>
            <priority>DISASTER</priority>
            <manual_close>NO</manual_close>
            <description>AP not responding to 3 pings. Check PoE switch port, cable, upstream switch.</description>
            <tags><tag><tag>scope</tag><value>availability</value></tag></tags>
        </trigger>
        <trigger>
            <uuid>e2cb16008a844061984a1fbab0799922</uuid>
            <expression>last(/Template SNMP Ruijie AP820-L V3/zabbix[host,snmp,available])=1</expression>
            <name>AP: SNMP agent unreachable</name>
            <priority>HIGH</priority>
            <manual_close>YES</manual_close>
            <description>ICMP OK but SNMP failing. Check community (AccessPoint1!), SNMP enabled, UDP 161 open.</description>
            <dependencies>
                <dependency>
                    <name>AP is UNREACHABLE - ICMP failed 3 times in a row</name>
                    <expression>max(/Template SNMP Ruijie AP820-L V3/icmpping,#3)=0</expression>
                </dependency>
            </dependencies>
            <tags><tag><tag>scope</tag><value>availability</value></tag></tags>
        </trigger>
        <trigger>
            <uuid>5c81b501fe234fe9a0f7fc44307ba113</uuid>
            <expression>last(/Template SNMP Ruijie AP820-L V3/if.uplink.status)=2</expression>
            <name>AP: Wired uplink port (Gi0/1) is DOWN</name>
            <priority>HIGH</priority>
            <manual_close>NO</manual_close>
            <description>GigabitEthernet 0/1 ifOperStatus=down. PoE link lost. Check switch port and cable.</description>
            <dependencies>
                <dependency>
                    <name>AP is UNREACHABLE - ICMP failed 3 times in a row</name>
                    <expression>max(/Template SNMP Ruijie AP820-L V3/icmpping,#3)=0</expression>
                </dependency>
            </dependencies>
            <tags><tag><tag>scope</tag><value>availability</value></tag></tags>
        </trigger>
        <trigger>
            <uuid>5911f8254bc14a14909239a765804ad9</uuid>
            <expression>last(/Template SNMP Ruijie AP820-L V3/if.radio5.status)=2</expression>
            <name>AP: 5GHz radio (Do2/0) is DOWN</name>
            <priority>HIGH</priority>
            <manual_close>YES</manual_close>
            <description>Dot11radio 2/0 down. Wi-Fi 6 clients cannot connect.</description>
            <tags><tag><tag>scope</tag><value>availability</value></tag></tags>
        </trigger>
        <trigger>
            <uuid>4ca8d84cf391410f81a74eb3486d7c14</uuid>
            <expression>last(/Template SNMP Ruijie AP820-L V3/if.radio24.status)=2</expression>
            <name>AP: 2.4GHz radio (Do1/0) is DOWN</name>
            <priority>AVERAGE</priority>
            <manual_close>YES</manual_close>
            <description>Dot11radio 1/0 down. 2.4GHz clients cannot connect.</description>
            <tags><tag><tag>scope</tag><value>availability</value></tag></tags>
        </trigger>
        <trigger>
            <uuid>a5194fa4a9e6480c9c85fc10da8fede9</uuid>
            <expression>last(/Template SNMP Ruijie AP820-L V3/system.uptime) &lt; {$REBOOT_UPTIME} and last(/Template SNMP Ruijie AP820-L V3/system.uptime) &gt; 0</expression>
            <name>AP: Device rebooted (uptime below {$REBOOT_UPTIME}s)</name>
            <priority>AVERAGE</priority>
            <manual_close>YES</manual_close>
            <description>sysUpTime below threshold. AP recently rebooted. Check PoE and AP logs if unexpected.</description>
            <tags><tag><tag>scope</tag><value>availability</value></tag></tags>
        </trigger>
        <trigger>
            <uuid>183441c8612c4f5cb0d28fc5eb08aa38</uuid>
            <expression>last(/Template SNMP Ruijie AP820-L V3/ruijie.ram.used.pct) &gt; {$RAM_USED_MAX}</expression>
            <name>AP: RAM usage above {$RAM_USED_MAX}% ({ITEM.LASTVALUE})</name>
            <priority>WARNING</priority>
            <manual_close>YES</manual_close>
            <description>RAM above threshold. AP820-L(V3) has 512 MB total.</description>
            <dependencies>
                <dependency>
                    <name>AP is UNREACHABLE - ICMP failed 3 times in a row</name>
                    <expression>max(/Template SNMP Ruijie AP820-L V3/icmpping,#3)=0</expression>
                </dependency>
            </dependencies>
            <tags><tag><tag>scope</tag><value>performance</value></tag></tags>
        </trigger>
        <trigger>
            <uuid>509bc26bbe3f4f0ebdd39775d2dde704</uuid>
            <expression>min(/Template SNMP Ruijie AP820-L V3/icmppingloss,3m) &gt; {$ICMP_LOSS_WARN}</expression>
            <name>AP: High ICMP packet loss ({ITEM.LASTVALUE} &gt; {$ICMP_LOSS_WARN}%)</name>
            <priority>WARNING</priority>
            <manual_close>YES</manual_close>
