    <templates>
        <template>
            <uuid>668038b3101c42e492ed2916cd4c8415</uuid>
            <template>Template SNMP Ruijie AP820-L V3</template>
            <name>Template SNMP Ruijie AP820-L V3</name>
            <description>SNMP monitoring for Ruijie RG-AP820-L(V3) Wi-Fi 6. All OIDs confirmed from live snmpwalk on RGOS 11.9(6)W3B1P3. ifIndex 1=Gi0/1 2=Do1/0(2.4G) 4=Do2/0(5G). Community: AccessPoint1!</description>
            <groups>
                <group><name>Templates/Network Devices</name></group>
                <group><name>Templates/Wireless</name></group>
            </groups>
            <macros>
                <macro><macro>{$SNMP_COMMUNITY}</macro><value>AccessPoint1!</value><description>SNMPv2c community string</description></macro>
                <macro><macro>{$ICMP_LOSS_WARN}</macro><value>20</value><description>Packet loss % WARNING threshold</description></macro>
                <macro><macro>{$ICMP_LATENCY_WARN}</macro><value>150</value><description>Latency ms WARNING threshold</description></macro>
                <macro><macro>{$REBOOT_UPTIME}</macro><value>600</value><description>Uptime seconds below which reboot alert fires</description></macro>
                <macro><macro>{$RAM_USED_MAX}</macro><value>80</value><description>RAM used % WARNING threshold</description></macro>
            </macros>
            <items>
                <item>
                    <uuid>9d47afaa23aa4d56aa673fffc7c6d0ed</uuid>
                    <name>ICMP: Ping (Reachability)</name>
                    <type>SIMPLE</type>
                    <key>icmpping</key>
                    <delay>30s</delay>
                    <history>30d</history>
                    <trends>90d</trends>
                    <value_type>UNSIGNED</value_type>
                    <description>Returns 1=up 0=down</description>
                    <valuemap><name>Service state</name></valuemap>
                </item>
                <item>
                    <uuid>2e6469bc1c4e4dcb90efc54f46c9249c</uuid>
                    <name>ICMP: Round-Trip Latency (ms)</name>
                    <type>SIMPLE</type>
                    <key>icmppingsec</key>
                    <delay>60s</delay>
                    <history>30d</history>
                    <trends>90d</trends>
                    <value_type>FLOAT</value_type>
                    <units>ms</units>
                    <description>Avg ICMP round-trip time</description>
                </item>
                <item>
                    <uuid>23c51a04aa0a4fb28eda698d67b47262</uuid>
                    <name>ICMP: Packet Loss (%)</name>
                    <type>SIMPLE</type>
                    <key>icmppingloss</key>
                    <delay>60s</delay>
                    <history>30d</history>
                    <trends>90d</trends>
                    <value_type>FLOAT</value_type>
                    <units>%</units>
                    <description>% ICMP packets lost</description>
                </item>
                <item>
                    <uuid>5b205c32faa24245be2d988e0c3a80af</uuid>
                    <name>SNMP: Agent Availability</name>
                    <type>INTERNAL</type>
                    <key>zabbix[host,snmp,available]</key>
                    <delay>1m</delay>
                    <history>30d</history>
                    <trends>90d</trends>
                    <value_type>UNSIGNED</value_type>
                    <description>0=available 1=unavailable 2=unknown</description>
                    <valuemap><name>zabbix.host.available</name></valuemap>
                </item>
                <item>
                    <uuid>764b505f9e894319bb63f46f3e74595e</uuid>
                    <name>System: Description</name>
                    <type>SNMP_AGENT</type>
                    <snmp_oid>1.3.6.1.2.1.1.1.0</snmp_oid>
                    <key>system.descr</key>
                    <delay>1h</delay>
                    <history>30d</history>
                    <trends>0</trends>
                    <value_type>TEXT</value_type>
                    <description>sysDescr.0 Confirmed: Ruijie AP820-L(V3) RGOS 11.9(6)W3B1P3</description>
                </item>
