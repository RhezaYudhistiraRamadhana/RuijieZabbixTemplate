                <item>
                    <uuid>93462af3358445e999ae79c9afa9cd69</uuid>
                    <name>Ruijie: RAM Used (%)</name>
                    <type>CALCULATED</type>
                    <key>ruijie.ram.used.pct</key>
                    <delay>3m</delay>
                    <history>30d</history>
                    <trends>90d</trends>
                    <value_type>FLOAT</value_type>
                    <units>%</units>
                    <params>(last(//ruijie.ram.total)-last(//ruijie.ram.free))/last(//ruijie.ram.total)*100</params>
